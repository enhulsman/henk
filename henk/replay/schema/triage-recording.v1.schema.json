{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/enhulsman/henk/triage-recording.v1.schema.json",
  "title": "Henk triage recording",
  "description": "One recording per event triage (triage-quality design D13): exactly what the model was sent and what it did, for replay. A recording is NOT an audit record. It lives in `triage-recordings/` beside the audit log, is bounded (256 KB, 200 files, 30 days), may be deleted by retention, and is never read by cadence rehydration. It holds tool arguments, tool result text and memory content, so it never enters the repository. Reconstructed cases (group 12b) use the same shape with `reconstructed: true`, where a transcript entry's arguments may be the string `unknown`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recording_id",
    "at",
    "reconstructed",
    "incidents",
    "announceable",
    "suppressed_count",
    "content",
    "profile",
    "hashes",
    "transcript",
    "reply",
    "ending",
    "complete",
    "incomplete_reasons",
    "prior_handoff_ids",
    "approvals",
    "usage",
    "observed_model"
  ],
  "properties": {
    "schema": {
      "const": "henk.triage-recording.v1"
    },
    "recording_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
      "description": "The UTC time the recording was made, then 8 random hex digits. The file is `<recording_id>.json`, and the audit record's `recording_id` names it."
    },
    "at": {
      "type": "number",
      "description": "Unix time the recording was made."
    },
    "reconstructed": {
      "type": "boolean",
      "description": "False for a recording made live at triage completion; true for a case rebuilt after the fact from preserved material."
    },
    "incidents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/incident"
      }
    },
    "announceable": {
      "type": "boolean",
      "description": "Whether the triage's message was to be sent (false for a cap-overflow triage)."
    },
    "suppressed_count": {
      "type": "integer",
      "minimum": 0
    },
    "content": {
      "type": "string",
      "description": "The composed event-turn content exactly as passed to the agent session. Never shortened: a recording that cannot fit its bound without cutting this is not written."
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "effort",
        "thinking"
      ],
      "properties": {
        "name": {
          "enum": [
            "chat",
            "event"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "The profile of the factory that created the session, with the model, effort and thinking it configured. Null means not configured (the CLI's default) or not known."
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_prompt",
        "tool_definitions"
      ],
      "properties": {
        "system_prompt": {
          "$ref": "#/definitions/hash"
        },
        "tool_definitions": {
          "$ref": "#/definitions/hash"
        }
      },
      "description": "Hashes a replay compares against its own, to report drift. Null when the session's factory does not expose them."
    },
    "transcript": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/call"
      },
      "description": "Every tool call of the triage turn, in order, including calls the closed-toolset hook or the approval gate denied."
    },
    "reply": {
      "type": [
        "string",
        "null"
      ],
      "description": "The turn's reply text as the session returned it, or null when the turn raised. Kept even when the ending discarded it."
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "error_class",
        "http_status"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "completed",
            "error",
            "refused",
            "no-reply"
          ]
        },
        "error_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "http_status": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          ]
        }
      },
      "description": "The triage ending classification (incident-triage spec, design D12)."
    },
    "complete": {
      "type": "boolean",
      "description": "True only when the recording holds the whole turn as observed. False when a result was shortened to fit the size bound, or the session exposed no transcript."
    },
    "incomplete_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "truncated",
          "transcript-unavailable"
        ]
      }
    },
    "prior_handoff_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "The handoff archive row ids the triage's digest showed."
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/approval"
      },
      "description": "The gate's decisions during the triage, as the audit record's approvals carry them."
    },
    "usage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "cache_read_input_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cache_read_input_tokens": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    },
    "observed_model": {
      "type": [
        "string",
        "null"
      ],
      "description": "The model the SDK stream reported, when it reported one."
    },
    "reference": {
      "$ref": "#/definitions/reference"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "incomplete_reasons": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "incomplete_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transcript": {
            "contains": {
              "required": [
                "truncated_bytes"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          },
          "incomplete_reasons": {
            "contains": {
              "const": "truncated"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconstructed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "transcript": {
            "items": {
              "properties": {
                "arguments": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "hash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_key",
        "source",
        "name",
        "state",
        "event_id",
        "title",
        "message",
        "notified",
        "received",
        "recurrence",
        "prior_handoff_ref"
      ],
      "properties": {
        "identity_key": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "notified": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The notification time (D6): when it was sent, not when the condition began. Null when the frame carried no usable time."
        },
        "received": {
          "type": [
            "number",
            "null"
          ],
          "description": "When Henk received the event (D6)."
        },
        "recurrence": {
          "type": "boolean"
        },
        "prior_handoff_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments",
        "result",
        "is_error"
      ],
      "properties": {
        "tool_use_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The registry name (the `mcp__henk__` prefix removed), or the built-in's own name for a call the closed-toolset hook blocked."
        },
        "arguments": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "const": "unknown"
            }
          ],
          "description": "The call's arguments as the model sent them. `unknown` only in a reconstructed case."
        },
        "result": {
          "type": [
            "string",
            "null"
          ],
          "description": "The result text the model received, a denial included. Null when no answer arrived. A shortened result ends with `[truncated by the recorder: N bytes removed]`."
        },
        "is_error": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "truncated_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Present only on a shortened result: the UTF-8 bytes removed from it."
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tier",
        "outcome",
        "initiated_by",
        "reference"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": "string"
        },
        "initiated_by": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "culprit",
        "mechanism",
        "fix"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "description": "Which rule branch fired."
        },
        "culprit": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1,
          "description": "The correct fix."
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "The owner's verified ground truth (design D15). Never written by the live recorder."
    }
  }
}
