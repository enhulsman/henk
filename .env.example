# Henk secrets — copy to .env, `chmod 600 .env`, fill in. NEVER commit .env.

# Anthropic credential — consumed by the Claude Agent SDK directly.
# From `claude setup-token` (subscription OAuth):
CLAUDE_CODE_OAUTH_TOKEN=
# ...or a spend-capped API key instead (leave the OAuth one blank if you use this):
# ANTHROPIC_API_KEY=

# Tailscale pre-authorized auth key, scoped to tag:henk (generate AFTER the ACL
# PR merges; reusable off, ephemeral off).
TS_AUTHKEY=

# ntfy token (tk_...) — a SINGLE credential scoped per-topic server-side (design
# D3): publish on the notify topic, read on the events topic (henk-events), and
# publish on the handoffs topic (henk-handoffs). The instance stays default-deny,
# so topic names are not secrets. Extended for henk-events v1.2.
NTFY_TOKEN=

# obsidian-todo-api read token — leave blank if the API has no auth.
TODO_TOKEN=

# taiga_read is deferred to v1.1; TAIGA_TOKEN is unused in v1.
# TAIGA_TOKEN=
